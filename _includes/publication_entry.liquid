{% assign publication = include.publication %}
{% assign copy_payload = site.data.publication_citations[publication.id] %}
{% assign entry_id = include.anchor_prefix | default: '' | append: publication.id %}
{% assign publication_stage = publication.publication_stage | default: publication.status %}
{% assign paper_url = publication.pdf_url | default: publication.paper_url %}
{% if paper_url == null and publication.publisher_url %}
  {% unless publication.publisher_url contains 'doi.org' %}
    {% assign paper_url = publication.publisher_url %}
  {% endunless %}
{% endif %}
{% assign paper_label = 'Paper' %}
{% if publication.pdf_url or paper_url contains '.pdf' %}{% assign paper_label = 'PDF' %}{% endif %}

<article
  id="{{ entry_id }}"
  class="publication-record{% if publication.preview %} has-preview{% endif %}"
  {% if include.searchable %}
    data-publication-entry
    data-search="{{ publication.title | append: ' ' | append: publication.author_line | append: ' ' | append: publication.venue | append: ' ' | append: publication.year | append: ' ' | append: publication.tags | downcase | escape }}"
  {% endif %}
>
  {% if publication.preview %}
    <figure class="publication-record-figure">
      {% if publication.venue_abbr %}
        {% if publication.venue_url -%}
          <a class="publication-venue-badge-link" href="{{ publication.venue_url }}" aria-label="Visit {{ publication.venue | escape }}">
        {%- endif %}
        <span class="publication-venue-badge" title="{{ publication.venue | escape }}">{{ publication.venue_abbr }}</span>
        {% if publication.venue_url %}</a>{% endif %}
      {% endif %}
      {% if publication.preview_source_url -%}
        <a href="{{ publication.preview_source_url }}" aria-label="View the original figure source for {{ publication.title | escape }}">
      {%- endif %}
      <img
        src="{{ publication.preview | relative_url }}"
        alt="{{ publication.preview_alt | default: publication.title | escape }}"
        width="240"
        height="160"
        loading="{% if include.eager %}eager{% else %}lazy{% endif %}"
      >
      {% if publication.preview_source_url %}</a>{% endif %}
      {% if publication.preview_source_url %}
        <figcaption><a href="{{ publication.preview_source_url }}">Original paper figure</a></figcaption>
      {% endif %}
    </figure>
  {% endif %}

  <div class="publication-record-body">
    {% if publication.venue_abbr %}
      {% unless publication.preview %}
        {% if publication.venue_url -%}
          <a class="publication-inline-badge" href="{{ publication.venue_url }}" aria-label="Visit {{ publication.venue | escape }}">
        {%- else -%}
          <span class="publication-inline-badge">
        {%- endif %}
        {{- publication.venue_abbr -}}
        {% if publication.venue_url %}</a>{% else %}</span>{% endif %}
      {% endunless %}
    {% endif %}
    <h3 class="publication-record-title">{{ publication.title }}</h3>
    <div class="publication-authors">
      {% include publication_authors.liquid authors_html=publication.citation_authors_html %}
    </div>
    <p class="publication-venue">
      {% if publication_stage == 'preprint' %}
        <em>{{ publication.preprint_id | default: publication.venue }}</em>, {{ publication.year }}.
      {% else %}
        <em>
          {%- if publication.venue_url -%}
            <a href="{{ publication.venue_url }}">{{ publication.venue }}</a>
          {%- else -%}
            {{- publication.venue -}}
          {%- endif -%}
        </em>
        {%- if publication_stage == 'accepted' -%}
          , accepted
          {%- if publication.accepted_date %} {{ publication.accepted_date | date: '%-d %b %Y' }}{% else %}, {{ publication.year }}{% endif -%}
          .
        {%- elsif publication_stage == 'online' -%}
          , {{ publication.online_label | default: 'Published online' -}}
          {%- if publication.online_date %} {{ publication.online_date | date: '%-d %b %Y' }}{% else %}, {{ publication.year }}{% endif %}.
        {%- else -%}
          {%- if publication.volume %}, vol. {{ publication.volume }}{% endif -%}
          {%- if publication.issue %}, no. {{ publication.issue }}{% endif -%}
          {%- if publication.article_number %}, Art. no. {{ publication.article_number }}{% endif -%}
          {%- if publication.pages -%}
            , {% if publication.pages contains '-' %}pp. {% else %}p. {% endif -%}
            {{- publication.pages -}}
          {%- endif -%}
          , {{ publication.year }}.
        {%- endif -%}
      {% endif %}
    </p>

    <div class="publication-actions" aria-label="Publication actions">
      {% if publication.abstract %}
        <button
          type="button"
          class="publication-abstract-toggle publication-tooltip-trigger"
          data-tooltip="Show detailed abstract"
          aria-expanded="false"
          aria-controls="abstract-{{ entry_id }}"
        >
          Abstract
        </button>
      {% endif %}
      {% if paper_url -%}
        <a
          href="{{ paper_url }}"
          class="publication-tooltip-trigger"
          data-tooltip="{% if paper_label == 'PDF' %}Open the full-text PDF{% else %}Open the publisher page to access the paper{% endif %}"
        >
          {{- paper_label -}}
        </a>
      {%- endif %}
      {% if publication.doi -%}
        <span class="publication-doi-action">
          <button
            type="button"
            data-copy-value="{{ publication.doi | escape }}"
            data-copy-label="doi"
            data-copy-success-label="doi copied"
            data-copy-success="Copied doi: {{ publication.doi | escape }}"
            aria-describedby="doi-tip-{{ entry_id }}"
          >
            doi
          </button>
          <span id="doi-tip-{{ entry_id }}" class="publication-action-tooltip" role="tooltip">Copy doi: {{ publication.doi }}</span>
        </span>
      {%- endif %}
      {% assign artifacts = publication.artifacts %}
      {% if artifacts == null and publication.code_url %}
        {% assign artifacts = '' | split: '' %}
      {% endif %}
      {% if artifacts and artifacts.size > 0 %}
        <details class="publication-action-menu publication-artifact-menu">
          <summary class="publication-tooltip-trigger" data-tooltip="View available data and code resources">Data &amp; Code</summary>
          <div class="publication-action-menu-panel" role="group" aria-label="Data and code resources">
            {% for artifact in artifacts %}
              <a href="{{ artifact.url }}">{{ artifact.label | default: artifact.type | capitalize }}</a>
            {% endfor %}
          </div>
        </details>
      {% elsif publication.code_url %}
        <details class="publication-action-menu publication-artifact-menu">
          <summary class="publication-tooltip-trigger" data-tooltip="View available data and code resources">Data &amp; Code</summary>
          <div class="publication-action-menu-panel" role="group" aria-label="Data and code resources">
            <a href="{{ publication.code_url }}">Code</a>
          </div>
        </details>
      {% endif %}
      {% if copy_payload.ieee or copy_payload.nature or copy_payload.bibtex %}
        <details class="publication-action-menu publication-cite-menu">
          <summary class="publication-tooltip-trigger" data-tooltip="Choose a preferred citation format">Cite This</summary>
          <div class="publication-action-menu-panel" role="group" aria-label="Citation formats">
            {% if copy_payload.bibtex %}
              <div class="publication-citation-option">
                <button
                  type="button"
                  data-copy-source="bib-{{ entry_id }}"
                  data-copy-label="Copy - BibTeX"
                  data-copy-success="BibTeX copied to clipboard."
                >
                  Copy - BibTeX
                </button>
              </div>
            {% endif %}
            {% if copy_payload.ieee %}
              <div class="publication-citation-option">
                <button
                  type="button"
                  data-copy-source="cite-ieee-{{ entry_id }}"
                  data-copy-label="Copy - IEEE citation text"
                  data-copy-success="IEEE citation text copied to clipboard."
                  aria-describedby="cite-ieee-preview-{{ entry_id }}"
                >
                  Copy - IEEE citation text
                </button>
                <span id="cite-ieee-preview-{{ entry_id }}" class="publication-citation-preview" role="tooltip">
                  {{- copy_payload.ieee | escape -}}
                </span>
              </div>
            {% endif %}
            {% if copy_payload.nature %}
              <div class="publication-citation-option">
                <button
                  type="button"
                  data-copy-source="cite-nature-{{ entry_id }}"
                  data-copy-label="Copy - Nature citation text"
                  data-copy-success="Nature citation text copied to clipboard."
                  aria-describedby="cite-nature-preview-{{ entry_id }}"
                >
                  Copy - Nature citation text
                </button>
                <span id="cite-nature-preview-{{ entry_id }}" class="publication-citation-preview" role="tooltip">
                  {{- copy_payload.nature | escape -}}
                </span>
              </div>
            {% endif %}
          </div>
        </details>
      {% endif %}
      {% if publication.abstract %}
        <div id="abstract-{{ entry_id }}" class="publication-abstract-panel" hidden>
          <p>{{ publication.abstract }}</p>
        </div>
      {% endif %}
    </div>

    {% if copy_payload.ieee %}
      <textarea id="cite-ieee-{{ entry_id }}" class="publication-copy-payload" tabindex="-1" aria-hidden="true">{{ copy_payload.ieee }}</textarea>
    {% endif %}
    {% if copy_payload.nature %}
      <textarea id="cite-nature-{{ entry_id }}" class="publication-copy-payload" tabindex="-1" aria-hidden="true">{{ copy_payload.nature }}</textarea>
    {% endif %}
    {% if copy_payload.bibtex %}
      <textarea id="bib-{{ entry_id }}" class="publication-copy-payload" tabindex="-1" aria-hidden="true">{{ copy_payload.bibtex }}</textarea>
    {% endif %}
    {% include publication_metrics.liquid publication=publication %}
  </div>
</article>
