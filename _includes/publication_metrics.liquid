{% assign verification = include.publication.verification %}
{% assign has_if = verification.if_value %}
{% assign has_jcr = verification.jcr_quartile %}
{% assign has_citescore = verification.citescore %}
<p class="publication-metric-line">
  {% if include.publication.citation_source_url %}
    <a href="{{ include.publication.citation_source_url }}" title="Citation count last checked {{ include.publication.citation_checked_at }}"
      >Citations {{ include.publication.citations -}}
    </a>
  {% else %}
    <span>Citations {{ include.publication.citations }}</span>
  {% endif %}
  {% if include.publication.type == 'journal' %}
    {% if has_if or has_jcr or has_citescore %}
      <span aria-hidden="true">·</span>
      {% if verification.metric_basis contains 'acceptance' -%}
        <span>At acceptance:</span>
      {%- else -%}
        <span>Verified metrics:</span>
      {%- endif %}
      {% if has_jcr -%}
        <span>
          {{- verification.jcr_year }} JCR {{ verification.jcr_quartile -}}
          {%- if verification.jcr_top_10 %} (Top 10%){% endif -%}
        </span>
      {%- endif %}
      {% if has_if -%}
        <span>
          {%- if has_jcr %}· {% endif -%}
          {{- verification.if_year }} IF {{ verification.if_value -}}
        </span>
      {%- endif %}
      {% if has_citescore -%}
        <span>
          {%- if has_jcr or has_if %}· {% endif -%}
          {{- verification.citescore_year }} CiteScore {{ verification.citescore -}}
        </span>
      {%- endif %}
    {% endif %}
  {% endif %}
</p>
